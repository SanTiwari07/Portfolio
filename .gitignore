# ─────────────────────────────────────────────────────
# Sanskar Portfolio v3 — .gitignore
# ─────────────────────────────────────────────────────

# Python
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.env
.env.local

# Node / React
portfolio/node_modules/
portfolio/dist/
portfolio/.env.local

# OS
.DS_Store
Thumbs.db
desktop.ini

# Editor
.vscode/settings.json
.idea/
*.swp
*.swo

# Build artifacts
dist/
build/
*.log
npm-debug.log*

# Large media — tracked in assets/ only, not duplicated
portfolio/public/assets/*
!portfolio/public/assets/resume/

# Temp / scratch
*.tmp
*.bak
